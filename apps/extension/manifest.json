
{
  "manifest_version": 3,
  "name": "Briefly",
  "version": "0.1.0",
  "description": "Understand more. Read less.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Briefly"
  }
}
